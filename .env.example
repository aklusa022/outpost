# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored and must never be committed — this file only documents the
# shape, with no real secrets in it.
#
# These are read by Next.js at build/dev time (`npm run dev`, `vinext build`).
# NEXT_PUBLIC_* vars are inlined into the client bundle; the rest are
# server-side only within this Next.js app.

# Deployment used by `npx convex dev` (see `npx convex dashboard`).
# Format: dev:<your-deployment-name>
CONVEX_DEPLOYMENT=

NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://<your-deployment>.convex.site

# Your app's own public origin (used for links/redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# Clerk (from your Clerk instance's API Keys page).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_FRONTEND_API_URL=https://<your-instance>.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://<your-instance>.clerk.accounts.dev

# ---------------------------------------------------------------------------
# NOT read from this file — these run only inside Convex functions, never in
# this Next.js app, so they belong on the Convex deployment's own env store,
# not here. Set each one with:
#   npx convex env set <NAME> "<value>"        (dev deployment)
#   npx convex env set <NAME> "<value>" --prod  (prod deployment)
#
#   CLERK_WEBHOOK_SECRET        Signing secret for the Clerk -> Convex user
#                                sync webhook (Clerk dashboard -> Webhooks ->
#                                your endpoint -> Signing Secret).
#   CLOUDFLARE_ACCOUNT_ID       Cloudflare account ID.
#   CLOUDFLARE_API_TOKEN        Account-scoped API token with Cloudflare
#                                Calls/Realtime permission (My Profile ->
#                                API Tokens -- NOT an R2 token).
#   REALTIMEKIT_APP_ID          The RealtimeKit App ID for this project.
#   REALTIMEKIT_PRESET_NAME     A real preset name from that app (e.g.
#                                `group_call_participant`), not the app name.
#
# Message attachments (Cloudflare R2, via the @convex-dev/r2 component):
#   R2_BUCKET                   Bucket name. Use a separate bucket per
#                                deployment (e.g. `<app>-attachments-dev` on
#                                dev, `<app>-attachments` on prod).
#   R2_ENDPOINT                 https://<account-id>.r2.cloudflarestorage.com
#   R2_ACCESS_KEY_ID            From an R2 API token with Object Read & Write
#   R2_SECRET_ACCESS_KEY         on the bucket(s) (R2 -> Manage R2 API Tokens).
#   R2_PUBLIC_URL               Optional. Public origin the bucket is served
#                                from (its custom domain, e.g.
#                                https://cdn.example.com). When set, files are
#                                viewed/downloaded through it as plain,
#                                cacheable URLs; when unset, hourly presigned
#                                S3 URLs are used instead. Change it here (not
#                                in code) if the domain ever moves.
#
# The bucket needs a CORS rule allowing GET, PUT and HEAD with the
# Content-Type header from the app's origins (see README).
# ---------------------------------------------------------------------------
