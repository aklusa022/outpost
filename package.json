{
  "name": "outpost-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "build:vinext:dev": "vinext build --mode dev",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache",
    "deploy:vinext:dev": "node scripts/build-dev-wrangler-config.mjs && wrangler deploy --config dist/server/wrangler.dev.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "@base-ui/react": "^1.8.0",
    "@clerk/clerk-react": "^5.25.0",
    "@clerk/nextjs": "^6.12.6",
    "@clerk/themes": "^2.4.57",
    "@cloudflare/kumo": "^2.13.2",
    "@cloudflare/realtimekit": "^2.0.2",
    "@cloudflare/realtimekit-react": "^2.0.2",
    "@cloudflare/realtimekit-react-ui": "^2.0.2",
    "@convex-dev/presence": "^0.4.0",
    "@convex-dev/r2": "^0.10.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "clsx": "^2.1.1",
    "convex": "^1.23.0",
    "next": "^16.3.2",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "react-server-dom-webpack": "^19.2.8",
    "svix": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "convex-test": "^0.0.56",
    "eslint": "^9",
    "eslint-config-next": "15.2.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "trustedDependencies": [
    "@clerk/shared",
    "unrs-resolver"
  ],
  "type": "module"
}
